params {
    // tests/data/ is synthetic (random sequence, written by
    // tests/make_test_data.py): this profile only exercises pipeline
    // mechanics, not biology, and runs offline -- the host index is built
    // from a tiny synthetic "host" instead of downloading panhuman-1, and
    // the Kraken2 database from the synthetic microbes and a made-up
    // taxonomy instead of downloading PlusPF
    input                  = 'tests/data/samplesheet.csv'
    host_fasta             = 'tests/data/host.fasta.gz'
    kraken2_build_fasta    = 'tests/data/genomes/*.fasta.gz'
    kraken2_build_taxonomy = 'tests/data/kraken2_taxonomy'
    // two real AMR genes are planted in the synthetic microbes, so the
    // test has hits in ABRicate's real databases; this list marks one of
    // them intrinsic to a made-up genus
    amr_intrinsic          = 'tests/data/amr_intrinsic.tsv'
}
