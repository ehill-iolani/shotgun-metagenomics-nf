manifest {
    name            = 'shotgun-metagenomics-nf'
    description     = 'ONT shotgun metagenomics (Rapid Barcoding Kit, no PCR): read QC, human read removal, taxonomic classification and AMR gene detection'
    mainScript      = 'main.nf'
    // the platform's launcher runs 24.04.4 (iolani_bioinfo_backend/Dockerfile NXF_VER)
    nextflowVersion = '>=24.04.0'
    version         = '0.1.1'
}

params {
    // see main.nf for the full param list / help text
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // where each module's container image is pulled from, read directly by the
    // modules' `container` directives (hence declared here). These defaults are
    // the upstream registries; the google_batch profile points both at the
    // project's own Artifact Registry mirror (scripts/mirror_images.sh) so a run
    // doesn't depend on quay.io / Docker Hub being reachable from every Batch VM
    container_registry = 'quay.io'
    dockerhub_registry = 'docker.io'

    // chopper filtering thresholds -- declared here (not as script-level
    // `params.x = value` in main.nf) so they're reliably set before any
    // included module reads them; profiles like `test` can still override.
    // Rapid-kit reads have no fixed length, so there's no maximum
    min_len  = 500
    min_qual = 10

    // same reason: read directly inside the BUILD_DEACON_INDEX/DEACON_DEPLETE
    // modules. Unset = the panhuman-1 human pangenome index, downloaded once
    // into db_cache; set to a FASTA to build a host index from it instead
    // (the test profile's tiny synthetic host, or a non-human host later)
    host_fasta = null

    // same reason: kraken2_db is read by KRAKEN2's memory below. The build
    // pair works like host_fasta: both set = build a Kraken2 database from
    // these genomes + taxonomy dir instead of downloading kraken2_db (the
    // test profile's synthetic microbes). kraken2_db is 'pluspf16' or
    // 'pluspf8', see modules/fetch_kraken2_db.nf
    kraken2_db             = 'pluspf16'
    kraken2_build_fasta    = null
    kraken2_build_taxonomy = null

    // same reason: read directly inside the KRAKEN2 module script. Set for
    // hac/sup basecalled reads; fast-model reads (~8% error) almost never
    // reach a 0.05 confidence, so WF_SHOTGUN warns when it sees them
    kraken2_confidence     = 0.05
    kraken2_min_hit_groups = 3

    // same reason: read directly inside the TAXON_ABUNDANCE module script.
    // Flag-only (below_threshold in taxon_abundance.tsv, nothing dropped),
    // on the reads Kraken2 assigned directly to the taxon; 0 = off.
    // min_rel_abundance is a fraction of the sample's host-removed reads
    min_reads         = 10
    min_rel_abundance = 0.0001

    // same reason: read directly inside the AMR modules. amr_tool is
    // 'minimap2' or 'abricate'; amr_db is one of ABRicate's bundled AMR
    // databases (ncbi, resfinder, argannot, card, megares). A hit passes at
    // amr_min_identity percent identity over at least amr_min_coverage
    // percent of the gene. amr_intrinsic lists genes usually intrinsic to
    // a genus, for amr_genes.tsv's `intrinsic` column
    amr_tool          = 'minimap2'
    amr_db            = 'ncbi'
    amr_min_identity  = 90
    amr_min_coverage  = 80
    amr_intrinsic     = "${projectDir}/assets/amr/intrinsic_genes.tsv"

    // same reason: read by the FETCH_* modules' storeDir directive, where
    // downloaded databases are cached so they're fetched once and reused
    db_cache = "${projectDir}/assets/db_cache"
}

// Declared before `profiles` (not after) -- Nextflow's config merging
// replaces a `withLabel` selector wholesale for whichever declaration wins,
// it doesn't merge individual directives within it. A block declared later
// in the file wins regardless of profile, so this has to come first for the
// google_batch profile's own withLabel overrides below to actually apply
// instead of being silently shadowed by these defaults.
process {
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '16.GB'
        time   = '8.h'
    }
    // Kraken2 holds its whole database in memory, so its memory follows the
    // database (hash.k2d: 15 GB PlusPF-16, 7.5 GB PlusPF-8) instead of its
    // label. withName outranks withLabel wherever either is declared, so
    // this holds under google_batch's withLabel blocks too (that profile's
    // own withName: KRAKEN2 repeats it)
    withName: KRAKEN2 {
        memory = { params.kraken2_build_fasta ? 2.GB : (params.kraken2_db == 'pluspf8' ? 10.GB : 20.GB) }
    }
    // A failed download is worth repeating whatever its exit code: a
    // dropped connection (curl 56) or a corrupted transfer (md5 mismatch)
    // isn't deterministic the way a failed analysis step is, so this
    // outranks google_batch's terminate-on-exit-code rule for these two.
    // FETCH_KRAKEN2_DB streams into tar, so it can only start over
    withName: 'FETCH_.*' {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled  = false
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        // set process.queue / clusterOptions per institution HPC as needed
    }
    test {
        includeConfig 'conf/test.config'
    }
    google_batch {
        process.executor      = 'google-batch'
        // Retry when Batch never gave a usable exit code -- a failed image
        // pull, a lost VM or a hit time limit all arrive as Nextflow's "no
        // exit status" (Integer.MAX_VALUE, printed as "-") -- or reports a
        // Batch-level code (>= 50000, e.g. 50001 Spot preemption). A script
        // that really exited 1-255 is deterministic, so retrying only repeats
        // it: that fails at once.
        process.errorStrategy = {
            (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus >= 50000)
                ? 'retry' : 'terminate'
        }
        process.maxRetries    = 3
        // a closure so it still follows --dockerhub_registry when that's
        // overridden from the params file, after this profile is read
        process.container     = { "${params.dockerhub_registry}/library/ubuntu:22.04" }

        google.project        = 'iscc-400300'
        google.location       = 'us-central1'
        google.batch.spot     = true
        // pinned explicitly: Batch re-runs a Spot-preempted task up to this many
        // times itself, and Nextflow >= 24.10 changed the default to 0
        google.batch.maxSpotAttempts = 5

        // images come from our own mirror, not quay.io / Docker Hub (see the
        // params block); the mirror keeps each image's upstream path, so both
        // registries are one repo. Override with --container_registry quay.io
        // --dockerhub_registry docker.io to pull from upstream instead
        params.container_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'
        params.dockerhub_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'

        workDir               = 'gs://nextflow-jobs/shotgun/work'
        params.outdir         = 'gs://nextflow-jobs/shotgun/results'

        // the FETCH_* storeDir has to be a GCS path here, not the base params
        // block's local ${projectDir}-relative default: those processes run on
        // a Batch VM, and the Batch task handler rejects a storeDir on the
        // machine that submitted the job
        params.db_cache       = 'gs://nextflow-jobs/shotgun/db_cache'

        docker.enabled        = true

        // larger allotments than the base process block, scaling with
        // task.attempt so retries (see errorStrategy/maxRetries above)
        // get more room instead of repeatedly failing at the same size
        process {
            withLabel: process_low {
                cpus   = 4
                memory = { 8.GB  * task.attempt }
                time   = { 2.h   * task.attempt }
            }
            withLabel: process_medium {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
            withLabel: process_high {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }

            // Batch never downloads inputs: a task's links point into the
            // bucket's gcsfuse mount. Kraken2 (>= 2.17) loads hash.k2d with 8
            // parallel reads at scattered offsets, which gcsfuse serves very
            // slowly (52 min for PlusPF-8's 7.8 GB, 2026-10-23 dry run), so the
            // database is copied in first, one sequential read, and Kraken2
            // reads the local copy. `disk` without a type is the VM's boot
            // disk, which holds the task's scratch dir (Batch's default is
            // 30 GB, ~10 of it the OS's). This block replaces the base
            // withName: KRAKEN2 wholesale, so its memory is repeated here
            withName: KRAKEN2 {
                memory      = { params.kraken2_build_fasta ? 2.GB : (params.kraken2_db == 'pluspf8' ? 10.GB : 20.GB) }
                stageInMode = 'copy'
                disk        = 100.GB
            }
            // the unpacked database is written to local scratch before it's
            // stored (15 GB for PlusPF-16)
            withName: FETCH_KRAKEN2_DB {
                disk = 100.GB
            }
        }
    }
}

timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
}
